# Server
PORT=3000
NODE_ENV=development

# Token required by GET /api/leads and the /admin.html inbox.
# Generate one: node -e "console.log(crypto.randomUUID())"
ADMIN_TOKEN=change-me-before-deploying

# Capacity shown in the hero and the booking form
MONTHLY_SLOTS=4

# Optional: post each new lead into a Telegram chat.
# Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
